# AllowPay — variáveis de ambiente (defina no painel da Vercel: Settings → Environment Variables)
# Preencha os valores APENAS na Vercel. NUNCA commite chaves reais neste arquivo.

# OBRIGATÓRIO — sua chave de seller AllowPay
ALLOWPAY_API_KEY=

# OPCIONAL (recomendado) — segredo que assina o webhook (HMAC-SHA256).
# Se definido, api/pix.js envia webhook_url+webhook_secret e o webhook valida a assinatura.
ALLOWPAY_WEBHOOK_SECRET=

# OPCIONAL — sobrescreve a URL base da API (default: https://allow-gi0i.onrender.com)
# ALLOWPAY_BASE_URL=https://allow-gi0i.onrender.com

# ─────────── UTMify (rastreamento de vendas server-side) ───────────
# OBRIGATÓRIO p/ o tracking de conversão — token da API de Orders (header x-api-token)
UTMIFY_API_TOKEN=

# OPCIONAL — "1" envia os pedidos como TESTE (isTest:true). Em produção, deixe VAZIO/0.
UTMIFY_TEST=

# OPCIONAL — sobrescreve a URL da API do UTMify
# UTMIFY_URL=https://api.utmify.com.br/api-credentials/orders

# Suporte: crie um banco Upstash Redis pelo Marketplace da Vercel e conecte ao projeto.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Use uma senha exclusiva e aleatoria de no minimo 16 caracteres. Apenas no servidor.
SUPPORT_ADMIN_PASSWORD=
